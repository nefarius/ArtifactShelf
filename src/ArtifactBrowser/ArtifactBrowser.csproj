<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- .NET 10 ships blazor.web.js via Microsoft.AspNetCore.App.Internal.Assets.
         The SDK should pull that pack when .razor files exist, but newer SDKs
         classify them as RazorComponent (not Content), so auto-detect stays false
         and a Docker layered restore plus publish without restore omits the file. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArtifactBrowser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.Utilities.AspNetCore" Version="2.9.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <ProjectReference Include="..\ArtifactBrowser.Client\ArtifactBrowser.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
  </ItemGroup>

</Project>
