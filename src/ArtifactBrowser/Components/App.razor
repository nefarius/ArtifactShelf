@using ArtifactBrowser.Features.Files
@using ArtifactBrowser.Options
@using Microsoft.Extensions.Options
@inject IOptions<ArtifactBrowserOptions> BrowserOptions
@inject SocialEmbedService SocialEmbeds

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["ArtifactBrowser.styles.css"]" />
    <script>
        (function () {
            var key = "artifact-browser.ui-scale";
            var raw = "";
            try {
                raw = localStorage.getItem(key) || "";
            } catch (e) { }
            var n = 100;
            var trimmed = String(raw).trim();
            if (/^[+-]?\d+$/.test(trimmed)) {
                var parsed = Number(trimmed);
                if (parsed >= -2147483648 && parsed <= 2147483647) {
                    n = parsed;
                    n = Math.round(n / 10) * 10;
                    if (n < 80) {
                        n = 80;
                    } else if (n > 200) {
                        n = 200;
                    }
                }
            }
            document.documentElement.style.setProperty("--ui-scale", String(n / 100));
        })();
    </script>
    <ImportMap />
    <HeadOutlet @rendermode="@RenderMode" />
    @* HeadOutlet must not be the last head child. WASM patches it with insertBefore
       against the next sibling; if that sibling is missing (or a browser extension
       mutated the end of <head>), rendering throws and the error UI appears. *@
    @if (Embed is { } embed)
    {
        <meta property="og:title" content="@embed.Title" />
        <meta property="og:description" content="@embed.Description" />
        <meta property="og:url" content="@embed.Url" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@embed.SiteName" />
        @if (embed.ImageUrl is { } imageUrl)
        {
            <meta property="og:image" content="@imageUrl" />
        }
        <meta name="twitter:card" content="@embed.TwitterCard" />
        <meta name="twitter:title" content="@embed.Title" />
        <meta name="twitter:description" content="@embed.Description" />
        <title>@embed.DocumentTitle</title>
    }
    else
    {
        <title>@BrowserOptions.Value.ResolvedDocumentTitle</title>
    }
</head>

<body>
    <Routes @rendermode="@RenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private SocialEmbed? Embed =>
        HttpContext is null ? null : SocialEmbeds.DescribeFolder(HttpContext.Request);

    // The browser owns all UI state; server-side prerendering is disabled so that page
    // components (which depend on WASM-only services) never execute on the server.
    private static readonly IComponentRenderMode RenderMode = new InteractiveWebAssemblyRenderMode(prerender: false);
}

</html>
