@namespace ArtifactBrowser.Client.Components

<nav class="breadcrumb" aria-label="Breadcrumb">
    <button type="button" class="breadcrumb__segment" @onclick="() => Navigate(string.Empty)">
        <svg viewBox="0 0 24 24" class="breadcrumb__home" focusable="false"><path d="M12 3l9 8h-3v9h-5v-6H11v6H6v-9H3z"/></svg>
        <span>root</span>
    </button>
    @foreach (var (segment, path) in Segments)
    {
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <button type="button" class="breadcrumb__segment" @onclick="() => Navigate(path)">@segment</button>
    }
</nav>

@code {
    [Parameter, EditorRequired]
    public string CurrentPath { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    private List<(string Segment, string Path)> Segments
    {
        get
        {
            var result = new List<(string, string)>();
            if (string.IsNullOrEmpty(CurrentPath))
            {
                return result;
            }

            var parts = CurrentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            var accumulated = string.Empty;
            foreach (var part in parts)
            {
                accumulated = accumulated.Length == 0 ? part : $"{accumulated}/{part}";
                result.Add((part, accumulated));
            }

            return result;
        }
    }

    private Task Navigate(string path) => OnNavigate.InvokeAsync(path);
}
