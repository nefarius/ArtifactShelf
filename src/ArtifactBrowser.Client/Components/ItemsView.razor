@namespace ArtifactBrowser.Client.Components
@using ArtifactBrowser.Client.Services
@using ArtifactBrowser.Client.Utilities
@inject SelectionService Selection
@inject FilesApiClient Api
@inject NavigationManager Nav
@inject ClipboardService Clipboard
@inject DownloadService Downloads
@implements IDisposable

@if (SortedEntries.Count == 0)
{
    <div class="empty-state">
        <p>This folder is empty@(HasFilter ? " or no items match your filter." : ".")</p>
    </div>
}
else if (Preferences.ViewMode == ViewMode.Details)
{
    <table class="items-table" role="grid">
        <thead>
            <tr>
                <th></th>
                <th scope="col">Name</th>
                <th scope="col">Size</th>
                <th scope="col">Modified</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in SortedEntries)
            {
                <tr class="items-table__row @(Selection.IsSelected(entry.Path) ? "is-selected" : "")"
                    tabindex="0"
                    @onclick="e => HandleClick(entry, e)" @ondblclick="() => Open(entry)"
                    @oncontextmenu="e => OpenContextMenu(entry, e)" @oncontextmenu:preventDefault
                    @onkeydown="e => HandleKey(entry, e)">
                    <td><FileIcon Entry="entry" /></td>
                    <td>@entry.Name</td>
                    <td class="items-table__size">@(entry.IsDirectory ? "" : FormatUtilities.FormatBytes(entry.Size))</td>
                    <td class="items-table__date">@FormatUtilities.FormatDate(entry.Modified)</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="items-tiles items-tiles--@Preferences.ItemSize.ToString().ToLowerInvariant() items-tiles--@Preferences.ViewMode.ToString().ToLowerInvariant()">
        @foreach (var entry in SortedEntries)
        {
            <div class="tile @(Selection.IsSelected(entry.Path) ? "is-selected" : "")" tabindex="0"
                 @onclick="e => HandleClick(entry, e)" @ondblclick="() => Open(entry)"
                 @oncontextmenu="e => OpenContextMenu(entry, e)" @oncontextmenu:preventDefault
                 @onkeydown="e => HandleKey(entry, e)" title="@entry.Name">
                @if (Preferences.ViewMode == ViewMode.Icons && entry.MediaCategory == MediaCategory.Image)
                {
                    <img class="tile__thumb" src="@Api.GetThumbnailUrl(entry.Path)" alt="" loading="lazy" />
                }
                else
                {
                    <FileIcon Entry="entry" />
                }
                <span class="tile__name">@entry.Name</span>
            </div>
        }
    </div>
}

<ContextMenu Open="_menuOpen" X="_menuX" Y="_menuY" OnClose="CloseMenu">
    <li role="presentation">
        <button type="button" class="context-menu__item@(_copyFailed ? " is-failed" : "")" role="menuitem" @onclick="CopyLinkAsync">
            @(_copyFailed ? "Copy failed" : "Copy link")
        </button>
    </li>
    <li role="presentation">
        <button type="button" class="context-menu__item" role="menuitem" @onclick="DownloadZipAsync">Download ZIP</button>
    </li>
</ContextMenu>

@code {
    [Parameter, EditorRequired]
    public List<FileEntryDto> Entries { get; set; } = new();

    [Parameter, EditorRequired]
    public BrowserPreferences Preferences { get; set; } = null!;

    [Parameter]
    public string FilterText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<FileEntryDto> OnOpen { get; set; }

    private bool _menuOpen;
    private double _menuX;
    private double _menuY;
    private FileEntryDto? _menuEntry;
    private bool _copyFailed;

    private bool HasFilter => !string.IsNullOrWhiteSpace(FilterText);

    private List<FileEntryDto> FilteredEntries => HasFilter
        ? Entries.Where(e => e.Name.Contains(FilterText, StringComparison.OrdinalIgnoreCase)).ToList()
        : Entries;

    // Folders always sort before files; within each group, sort by the selected field/direction.
    private List<FileEntryDto> SortedEntries => ApplySortDirection(FilteredEntries);

    private List<FileEntryDto> ApplySortDirection(List<FileEntryDto> filtered)
    {
        IOrderedEnumerable<FileEntryDto> ordered = Preferences.SortField switch
        {
            SortField.Size => filtered.OrderBy(e => e.IsDirectory ? 0 : 1).ThenBy(e => e.Size ?? -1),
            SortField.Modified => filtered.OrderBy(e => e.IsDirectory ? 0 : 1).ThenBy(e => e.Modified),
            SortField.Type => filtered.OrderBy(e => e.IsDirectory ? 0 : 1).ThenBy(e => e.Extension, StringComparer.OrdinalIgnoreCase),
            _ => filtered.OrderBy(e => e.IsDirectory ? 0 : 1).ThenBy(e => e.Name, NaturalSortComparer.Instance),
        };

        var result = ordered.ToList();
        if (!Preferences.SortDescending)
        {
            return result;
        }

        var dirCount = result.Count(e => e.IsDirectory);
        var dirs = Enumerable.Reverse(result.Take(dirCount));
        var files = Enumerable.Reverse(result.Skip(dirCount));
        return dirs.Concat(files).ToList();
    }

    protected override void OnInitialized() => Selection.Changed += OnSelectionChanged;

    private void OnSelectionChanged() => InvokeAsync(StateHasChanged);

    private void HandleClick(FileEntryDto entry, MouseEventArgs e) =>
        ApplySelection(entry, e.CtrlKey || e.MetaKey);

    private Task HandleKey(FileEntryDto entry, KeyboardEventArgs e)
    {
        if (e.Key == "ContextMenu" || (e.ShiftKey && e.Key == "F10"))
        {
            return OpenContextMenu(entry, clientX: 0, clientY: 0);
        }

        if (e.Key is not ("Enter" or " "))
        {
            return Task.CompletedTask;
        }

        ApplySelection(entry, e.CtrlKey || e.MetaKey);
        return Open(entry);
    }

    private void ApplySelection(FileEntryDto entry, bool toggle)
    {
        if (toggle)
        {
            Selection.Toggle(entry.Path);
        }
        else
        {
            Selection.Select(entry.Path);
        }
    }

    private void ApplyContextSelection(FileEntryDto entry)
    {
        if (!Selection.IsSelected(entry.Path))
        {
            Selection.Select(entry.Path);
        }
    }

    private Task OpenContextMenu(FileEntryDto entry, MouseEventArgs e) =>
        OpenContextMenu(entry, e.ClientX, e.ClientY);

    private async Task OpenContextMenu(FileEntryDto entry, double clientX, double clientY)
    {
        ApplyContextSelection(entry);
        _menuEntry = entry;
        _copyFailed = false;

        if (clientX == 0 && clientY == 0)
        {
            var point = await Clipboard.GetActiveElementRectAsync();
            clientX = point.X;
            clientY = point.Y;
        }

        _menuX = clientX;
        _menuY = clientY;
        _menuOpen = true;
    }

    private void CloseMenu()
    {
        _menuOpen = false;
        _copyFailed = false;
    }

    private async Task CopyLinkAsync()
    {
        if (_menuEntry is null)
        {
            return;
        }

        try
        {
            var url = PrettyUrl.FromVirtualPath(Nav.BaseUri, _menuEntry.Path);
            await Clipboard.CopyTextAsync(url);
            CloseMenu();
        }
        catch (Exception)
        {
            _copyFailed = true;
        }
    }

    private async Task DownloadZipAsync()
    {
        if (Selection.Selected.Count == 0)
        {
            return;
        }

        var paths = Selection.Selected.ToList();
        CloseMenu();
        await Downloads.DownloadArchiveAsync(Api.GetArchiveUrl(), paths);
    }

    private Task Open(FileEntryDto entry) => OnOpen.InvokeAsync(entry);

    public void Dispose() => Selection.Changed -= OnSelectionChanged;
}
